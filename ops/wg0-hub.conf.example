# MScale hub — Oracle Ubuntu 24.04 ARM. Copy to /etc/wireguard/wg0.conf
#
# RULES:
# - Client [Peer] rows: AllowedIPs = <overlay>/32 ONLY
# - India exit [Peer]: AllowedIPs = 100.64.1.2/32,0.0.0.0/1,128.0.0.0/1 (never 0.0.0.0/0)
# - Table = off: WireGuard must NOT change the hub main routing table (SSH stays on enp0s6).
#   Exit-via uses ip rule + table 100 (see hub_exit_policy.go), not wg-quick default routes.
# - Enable ops/protect-ssh.service BEFORE wg-quick@wg0 (SSH iptables before VPN starts).

[Interface]
Address = 100.64.0.1/10
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>
Table = off
# SSH first; then mesh forward/NAT.
PostUp = iptables -I INPUT 1 -p tcp --dport 22 -j ACCEPT; iptables -A FORWARD -i wg0 -o wg0 -j ACCEPT; iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT; iptables -A INPUT -i wg0 -p icmp -j ACCEPT; sysctl -w net.ipv4.ip_forward=1; iptables -t nat -A POSTROUTING -o enp0s6 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -o wg0 -j ACCEPT; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -D INPUT -i wg0 -p icmp -j ACCEPT; iptables -t nat -D POSTROUTING -o enp0s6 -j MASQUERADE

[Peer]
PublicKey = <PEER_PUBLIC_KEY>
AllowedIPs = 100.64.1.11/32
PersistentKeepalive = 25
