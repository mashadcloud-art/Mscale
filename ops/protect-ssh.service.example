# Install on ph (once):
#   sudo cp protect-ssh.service.example /etc/systemd/system/protect-ssh.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable protect-ssh
#   sudo systemctl start protect-ssh
#
# Runs BEFORE wg-quick@wg0 so port 22 stays open even if WireGuard routing misbehaves.

[Unit]
Description=Protect SSH before WireGuard
Before=wg-quick@wg0.service
After=network.target

[Service]
Type=oneshot
ExecStart=/sbin/iptables -I INPUT 1 -p tcp --dport 22 -j ACCEPT
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
